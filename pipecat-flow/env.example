# ============================================
# pipecat-flow Configuration
# Copy this file: cp env.example .env
# ============================================
# These keys configure the voice/AI bot pipeline. The Daily, Deepgram and Cartesia keys are needed
# only by the transports and cascade (STT -> LLM -> TTS) pipelines that use them, whatever
# LLM_PROVIDER is. The Gemini Live flows (hotel_concierge.py) only read GOOGLE_API_KEY.
# Of the LLM keys, only the one for your provider is required.

# ── Transport ──
# Daily.co API key for the Daily transport (-t daily). Not needed for -t webrtc.
# Get one at: https://dashboard.daily.co/developers
DAILY_API_KEY=

# ── Audio Services ──
# Deepgram API key for speech-to-text in the cascade pipeline examples.
# Get one at: https://console.deepgram.com/
DEEPGRAM_API_KEY=
# Cartesia API key for text-to-speech in the cascade pipeline examples (the quickstart also uses it for STT).
# Get one at: https://play.cartesia.ai/
CARTESIA_API_KEY=

# ── LLM Provider Selection ──
# Pick one of: openai | anthropic | google | aws. Optional; defaults to openai when unset.
# Only set the API key block matching this value.
LLM_PROVIDER=openai

# ── LLM API Keys ──
# Set the one matching LLM_PROVIDER above; leave the other LLM keys blank.
# Exceptions: examples/quickstart/hello_world.py always uses Google, so it needs GOOGLE_API_KEY
# whatever LLM_PROVIDER is set to. examples/llm_switching.py initializes OpenAI, Google, Anthropic
# and AWS Bedrock together, so it needs credentials for all of them.
# OpenAI: required when LLM_PROVIDER=openai. Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic: required when LLM_PROVIDER=anthropic. Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Google AI Studio: required when LLM_PROVIDER=google. Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ── AWS Bedrock ──
# AWS credentials are needed when LLM_PROVIDER=aws, but these static key variables are optional:
# the default credential chain also supports SSO and IAM roles. Leave them blank in that case.
# IAM secret access key for the bedrock-invoking principal.
AWS_SECRET_ACCESS_KEY=
# IAM access key id for the bedrock-invoking principal.
AWS_ACCESS_KEY_ID=
# AWS region for your Bedrock model. Optional; defaults to us-west-2 when unset.
AWS_REGION=us-west-2
